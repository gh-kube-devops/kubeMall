{
    "java.configuration.updateBuildConfiguration": "disabled",
    "java.compile.nullAnalysis.mode": "automatic",
    "terminal.integrated.defaultEncoding": "utf8",
    "terminal.integrated.defaultProfile.windows": "PowerShell",
    "java.compiler.annotationProcessing.enabled": true,
    "terminal.integrated.profiles.windows": {
        "PowerShell": {
            "source": "PowerShell",
            "args": ["-NoExit", "-Command", "[Console]::OutputEncoding = [System.Text.Encoding]::UTF8; chcp 65001"]
        }
    },
    "java.jdt.ls.vmargs": "-Dfile.encoding=UTF-8 -XX:+UseParallelGC",
}